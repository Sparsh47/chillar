{
  "expo": {
    "name": "Chillar",
    "slug": "chillar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chillar",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sparsh.chillar",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "upi",
          "gpay",
          "phonepe",
          "paytmmp",
          "upi",
          "gpay",
          "phonepe",
          "paytmmp"
        ],
        "NSCameraUsageDescription": "Chillar needs camera access to scan restaurant bills.",
        "NSPhotoLibraryUsageDescription": "Chillar needs photo library access to import receipt screenshots.",
        "NSBluetoothAlwaysUsageDescription": "Chillar uses Bluetooth to split bills with nearby friends offline.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sparsh.chillar",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0A0A0C"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "chillar.app",
              "pathPrefix": "/r"
            },
            {
              "scheme": "chillar"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Chillar needs camera access to scan restaurant bills.",
          "enableCodeScanner": true
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow Chillar to connect to nearby friends to split bills offline."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Chillar to pick bill screenshots from your gallery."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d72b594f-bc5a-49ce-8b58-e5fdc5e09984"
      }
    }
  }
}
